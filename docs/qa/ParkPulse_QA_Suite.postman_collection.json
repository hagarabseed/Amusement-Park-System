{
  "info": {
    "name": "ParkPulse Web API QA Suite",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080/api/v1" },
    { "key": "jwtToken", "value": "" },
    { "key": "operatorToken", "value": "" },
    { "key": "createdCustomerId", "value": "" },
    { "key": "issuedTicketCode", "value": "" }
  ],
  "item": [
    {
      "name": "1. Login as Manager",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200 OK', () => pm.response.to.have.status(200));",
              "const json = pm.response.json();",
              "pm.expect(json.token).to.be.a('string');",
              "pm.expect(json.role).to.eql('MANAGER');",
              "pm.collectionVariables.set('jwtToken', json.token);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\"email\":\"omar.manager@parkpulse.com\",\"password\":\"Pass@1234\"}"
        }
      }
    },
    {
      "name": "2. Unauthenticated Request Rejected (401)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 401 Unauthorized', () => pm.response.to.have.status(401));",
              "pm.expect(pm.response.json().title).to.eql('Unauthorized');"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/customers"
      }
    },
    {
      "name": "3. Register Customer (Positive)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 201 Created', () => pm.response.to.have.status(201));",
              "const json = pm.response.json();",
              "pm.expect(json.loyaltyPoints).to.eql(10);",
              "pm.collectionVariables.set('createdCustomerId', json.id);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{jwtToken}}" }
        ],
        "url": "{{baseUrl}}/customers",
        "body": {
          "mode": "raw",
          "raw": "{\"fullName\":\"QA Tester\",\"email\":\"qa.{{$timestamp}}@parkpulse.com\",\"phone\":\"010{{$randomInt}}\",\"initialDeposit\":100.00}"
        }
      }
    },
    {
      "name": "4. Issue Ticket with Promo (Positive)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 201 Created', () => pm.response.to.have.status(201));",
              "const json = pm.response.json();",
              "pm.expect(json.netAmount).to.eql(40.00);",
              "pm.expect(json.updatedBalance).to.eql(60.00);",
              "pm.expect(json.ticketCode).to.match(/^PKP-/);",
              "pm.collectionVariables.set('issuedTicketCode', json.ticketCode);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{jwtToken}}" }
        ],
        "url": "{{baseUrl}}/pos/tickets",
        "body": {
          "mode": "raw",
          "raw": "{\"customerId\":{{createdCustomerId}},\"passType\":\"REGULAR\",\"paymentMethod\":\"WRISTBAND\",\"promoCode\":\"SUMMER20\"}"
        }
      }
    },
    {
      "name": "5. Insufficient Balance Rejection (Negative)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 422 Unprocessable Entity', () => pm.response.to.have.status(422));",
              "pm.expect(pm.response.json().detail).to.include('Insufficient wristband balance');"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{jwtToken}}" }
        ],
        "url": "{{baseUrl}}/pos/tickets",
        "body": {
          "mode": "raw",
          "raw": "{\"customerId\":{{createdCustomerId}},\"passType\":\"FAMILY\",\"paymentMethod\":\"WRISTBAND\"}"
        }
      }
    },
    {
      "name": "6. Login as Ride Operator",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200 OK', () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set('operatorToken', pm.response.json().token);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\"email\":\"ahmed.operator@parkpulse.com\",\"password\":\"Pass@1234\"}"
        }
      }
    },
    {
      "name": "7. Ride Operator Blocked from Customer POS (403 RBAC)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 403 Forbidden', () => pm.response.to.have.status(403));"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{operatorToken}}" }],
        "url": "{{baseUrl}}/customers"
      }
    },
    {
      "name": "8. Ride Boarding Safety BVA Rejection (422)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 422 Unprocessable Entity', () => pm.response.to.have.status(422));",
              "pm.expect(pm.response.json().detail).to.include('Minimum age');"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{operatorToken}}" }
        ],
        "url": "{{baseUrl}}/rides/1/board",
        "body": {
          "mode": "raw",
          "raw": "{\"ticketCode\":\"{{issuedTicketCode}}\",\"guestAge\":13,\"guestHeightM\":1.55}"
        }
      }
    },
    {
      "name": "9. Ride Boarding Exact Boundary Success (201)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 201 Created', () => pm.response.to.have.status(201));",
              "pm.expect(pm.response.json().ticketCode).to.eql(pm.collectionVariables.get('issuedTicketCode'));"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{operatorToken}}" }
        ],
        "url": "{{baseUrl}}/rides/1/board",
        "body": {
          "mode": "raw",
          "raw": "{\"ticketCode\":\"{{issuedTicketCode}}\",\"guestAge\":14,\"guestHeightM\":1.40}"
        }
      }
    }
  ]
}
